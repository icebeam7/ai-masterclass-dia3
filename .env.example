# Foundry: endpoint del PROYECTO, deployments existentes
AZURE_AI_PROJECT_ENDPOINT=https://RECURSO.services.ai.azure.com/api/projects/PROYECTO
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Reutilizar índice Search de la Clase 2
AZURE_SEARCH_ENDPOINT=https://TU-SERVICIO.search.windows.net
AZURE_SEARCH_INDEX=enterprise-knowledge-v1
AZURE_SEARCH_ADMIN_KEY=CAMBIAR_CLAVE_SEARCH
TOP_K=4
# Blob Storage: origen del índice, administrado por scripts de rag_clase2
AZURE_STORAGE_ACCOUNT_URL=https://TU-CUENTA.blob.core.windows.net
AZURE_STORAGE_CONTAINER=enterprise-documents
AZURE_STORAGE_PREFIX=
# Cosmos DB NoSQL, creado con Bicep
COSMOS_ENDPOINT=https://TU-COSMOS.documents.azure.com:443/
COSMOS_DATABASE=enterprise-support
COSMOS_CONTAINER=tickets
# Solo demo local: separar desde la UI el backend de persistencia
TICKET_API_URL=http://127.0.0.1:8070
TICKET_API_KEY=CAMBIAR_TOKEN_LOCAL_LARGO_Y_ALEATORIO
# Controles opcionales; si se desactiva no se afirma protección integral
MAX_AGENT_STEPS=5

# Opcional: Azure AI Content Safety + Prompt Shields reales; ausencia = no hay filtro externo
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_THRESHOLD=4

# MCP: servidor local real (Streamable HTTP, solo lectura)
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_PORT=8001
